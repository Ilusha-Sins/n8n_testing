          "id": "KurJSVfWMCuegZSy",
          "name": "Bearer Auth account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const apiResponse = $json;\nconst requestData = $('Prepare API Request').first().json;\n\nconst authenticated = apiResponse.authenticated === true;\nconst tokenWasReceived = Boolean(apiResponse.token);\n\nreturn [\n  {\n    json: {\n      run_id: requestData.run_id,\n      api_service: requestData.api_service,\n      request_url: requestData.request_url,\n      auth_result: authenticated ? 'success' : 'failed',\n      api_authenticated: authenticated,\n      token_received_by_api: tokenWasReceived,\n      message: authenticated\n        ? 'Demo API accepted the Bearer credential from n8n'\n        : 'Demo API did not accept the Bearer credential',\n      created_at: requestData.created_at\n    }\n  }\n];"
      },
